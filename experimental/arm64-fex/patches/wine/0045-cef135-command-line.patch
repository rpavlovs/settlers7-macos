--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -2259,6 +2259,41 @@
 }
 
 
+#ifdef __i386__
+/* CEF 135.0.20, as used by Ubisoft Connect, disables Chromium command-line
+ * processing in cef_settings_t. Preserve the CodeWeavers CW HACK 25737
+ * compatibility behavior so software-rendering options can take effect.
+ * Adapted from CrossOver 26.3 ntdll/loader.c; LGPL-2.1-or-later.
+ * This only changes a signature-matched, loaded image, never its file. */
+static void enable_cef135_command_line( WINE_MODREF *wm )
+{
+    static const BYTE before[] = {0x8b,0x47,0x34,0x89,0x46,0x34,0x8b,0x47,0x38,0x89,0x46,0x38};
+    static const BYTE after[]  = {0x8b,0x47,0x34,0x89,0x46,0x34,0x31,0xc0,0x90,0x89,0x46,0x38};
+    const SIZE_T offset = 0x11e92d;
+    SIZE_T size = sizeof(before);
+    void *target, *page;
+    ULONG old_protect, ignored;
+    NTSTATUS status;
+
+    if (wcscmp( wm->ldr.BaseDllName.Buffer, L"libcef.dll" ) ||
+        wm->ldr.SizeOfImage < offset + sizeof(before)) return;
+    target = (BYTE *)wm->ldr.DllBase + offset;
+    if (memcmp( target, before, sizeof(before) )) return;
+    page = target;
+    if ((status = NtProtectVirtualMemory( NtCurrentProcess(), &page, &size,
+                                         PAGE_EXECUTE_READWRITE, &old_protect )))
+    {
+        WARN( "CEF 135 command-line compatibility protection failed: %lx\n", status );
+        return;
+    }
+    memcpy( target, after, sizeof(after) );
+    NtFlushInstructionCache( NtCurrentProcess(), target, sizeof(after) );
+    status = NtProtectVirtualMemory( NtCurrentProcess(), &page, &size, old_protect, &ignored );
+    if (status) ERR( "CEF 135 protection restore failed: %lx\n", status );
+    else WARN( "Enabled CEF 135 command-line rendering options\n" );
+}
+#endif
+
 /*************************************************************************
  *		build_module
  *
@@ -2339,6 +2374,10 @@
 
     TRACE_(loaddll)( "Loaded %s at %p: %s\n", debugstr_w(wm->ldr.FullDllName.Buffer), *module,
                      is_builtin ? "builtin" : "native" );
+
+#ifdef __i386__
+    enable_cef135_command_line( wm );
+#endif
 
     wm->ldr.LoadCount = 1;
     *pwm = wm;
